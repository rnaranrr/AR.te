# Banco de dados MySQL
DB_HOST=localhost
DB_NAME=arte
DB_USER=root
DB_PASS=sua_senha

# OBRIGATÓRIO: chave que assina e valida os tokens de login (usuários e moderadores).
# Precisa ter pelo menos 32 caracteres aleatórios; o servidor não inicia sem ela.
# Para gerar uma, rode:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

PORT=3000
